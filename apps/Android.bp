android_app_import {
    name: "Gramophone",
    apk: "gramophone/Gramophone.apk",
    presigned: true,
    preprocessed: true,
    product_specific: true,
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
}

android_app_import {
    name: "Jellyfish",
    apk: "jellyfish/Jellyfish.apk",
    certificate: "platform",
    product_specific: true,
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
}

android_app_import {
    name: "F-Droid",
    apk: "fdroid/F-Droid.apk",
    presigned: true,
    product_specific: true,
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
}

android_app_import {
    name: "NumberHub",
    apk: "NumberHub/NumberHub.apk",
    certificate: "shared",
    product_specific: true,
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
}
